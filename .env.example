# video-pls-bot configuration. Required keys are uncommented; optional ones are
# commented out (uncomment only with a value: an empty value is not a default).
# Copy to .env (local run) or to
# /etc/video-pls-bot/video-pls-bot.env (systemd EnvironmentFile=) and fill in.
# Local run: set -a; . ./.env; set +a; .venv/bin/python -m video_pls_bot.app

# --- Required -----------------------------------------------------------------

# Bot tokens from @BotFather, comma-separated. Alternative: BOT_TOKENS_FILE with a
# JSON list of tokens, or the systemd credential bot-tokens.json (production).
# Never put tokens into the systemd EnvironmentFile; use the credential there.
BOT_TOKENS=
# BOT_TOKENS_FILE=

# Loopback HTTP proxy for all downloads, e.g. http://127.0.0.1:3128.
DOWNLOAD_PROXY=
# Local Telegram Bot API server, e.g. http://127.0.0.1:8081.
TELEGRAM_API_BASE=

# Telegram chat id that receives error alerts and the daily digest.
ALERT_CHAT_ID=
# Numeric id of the bot that sends them (the part of its token before ':').
ALERT_BOT_ID=

# --- Local Telegram Bot API (video_pls_bot.api_server / video-pls-api.service) ---

# Port of the local Bot API; must match TELEGRAM_API_BASE.
TELEGRAM_API_PORT=
# Application credentials from https://my.telegram.org (used only when the
# systemd credential telegram-api.env is not provided).
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# 1: hand finished files to the local Bot API by file:// (needs group telegram-bot-api).
# TELEGRAM_LOCAL_FILES=
# Optional: loopback port of the proxy's transparent TCP inbound; video-pls-api-route.service
# redirects only the video-pls-api user's outbound TCP there.
# TELEGRAM_API_REDIRECT_PORT=

# --- Optional -----------------------------------------------------------------

# JSON file with Telegram texts (same keys as video_pls_bot/texts.py) to translate or
# reword them; without it the bots speak English.
# BOT_TEXTS_FILE=

# Fallback bot usernames for alerts when getMe fails: "123:first_bot,456:second_bot".
# BOT_USERNAMES=
# Unix socket of an external shared download queue; empty: the bot uses only its own limit.
# CORE_SOCKET=
# systemd unit of the download proxy to watch in the health check.
# HEALTH_PROXY_UNIT=

# Cookie files in Netscape format (or systemd credentials youtube-cookies.txt / tiktok-cookies.txt).
# YOUTUBE_COOKIES_FILE=
# TIKTOK_COOKIES_FILE=
# tmpfs directory for per-job cookie copies.
# COOKIE_TEMP_DIR=

# Storage (defaults: /var/lib/video-pls-bot, /var/cache/video-pls-bot).
# DATA_DIR=
# TEMP_DIR=

# Limits (defaults: 2, 20, 3600, 0 = no duration cap, 2000000000, 10000000000).
# CONCURRENCY=
# MAX_WAITING=
# JOB_TIMEOUT=
# MAX_DURATION=
# MAX_BYTES=
# TEMP_BUDGET_BYTES=

# Binaries (defaults: /usr/bin/node, /usr/bin/ffmpeg, /usr/bin/ffprobe).
# NODE_BINARY=
# FFMPEG_BINARY=
# FFPROBE_BINARY=

# --- vpb CLI installer (deploy/install-vpb.sh, on the admin machine) -------------

# Existing root SSH alias of the server, used once for provisioning.
# VPB_SSH_ALIAS=
# Loopback port of DOWNLOAD_PROXY on the server; the only port the vpb-auth key may forward.
# VPB_PROXY_PORT=

# --- deploy/install.sh (on the server) -------------------------------------------

# User allowed to run video-pls-stats through sudo.
# STATS_SUDO_USER=
# Executable with site-specific additions (proxy unit, drop-ins); gets the release dir.
# VIDEO_PLS_SITE_HOOK=
